# Copy this file to .env and fill in your own provider settings.
# Never commit the resulting .env file.

PIVORAG_LLM_API_KEY=
PIVORAG_LLM_BASE_URL=https://your-llm-provider.example/v1
PIVORAG_LLM_MODEL=your-llm-model

PIVORAG_EMBEDDING_API_KEY=
PIVORAG_EMBEDDING_BASE_URL=https://your-embedding-provider.example/v1
PIVORAG_EMBEDDING_MODEL=your-embedding-model

PIVORAG_RERANK_API_KEY=
PIVORAG_RERANK_BASE_URL=https://your-reranker-provider.example/v1/rerank
PIVORAG_RERANK_MODEL=your-reranker-model

# Set to false if no rerank service is configured.
PIVORAG_USE_RERANKER=false
PIVORAG_ENTITY_EXTRACTOR_BACKEND=spacy
PIVORAG_SPACY_MODEL_PATH=en_core_web_lg
PIVORAG_QUERY_DECOMPOSE=false
